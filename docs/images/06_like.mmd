sequenceDiagram
    autonumber
    participant U as 前端
    participant G as Gateway
    participant I as Interaction RPC
    participant DB as MySQL
    participant OB as Outbox Job
    participant K as Kafka
    participant IS as interaction_sync
    participant R as Redis

    U->>G: POST /interaction/like { video_id }
    G->>I: LikeVideo(user_id=JWT.uid, video_id)
    I->>DB: BEGIN
    I->>DB: INSERT likes ON DUPLICATE KEY UPDATE status=1
    I->>DB: INSERT outbox_events(like.created)
    I->>DB: COMMIT
    I->>R: INCR fsz:video:likes:{videoID}<br/>SET fsz:user:liked:{u}:{v}=1
    I-->>G: { liked:true, likes_count }

    OB->>K: like.created
    K->>IS: LikeEvent
    IS->>R: 二次校准 likes 计数（幂等）
    IS->>K: Produce video.stat.delta.events (delta_likes=+1)
    IS->>DB: INSERT processed_events
